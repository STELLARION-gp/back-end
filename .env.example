# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stellarion

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-auth-domain

# AdminJS Configuration (Generate using: openssl rand -base64 32)
ADMIN_SESSION_SECRET=your-strong-random-secret-here
ADMIN_COOKIE_PASSWORD=your-strong-cookie-password-here

# Server Configuration
PORT=5000
NODE_ENV=development

# API Keys (if needed)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
