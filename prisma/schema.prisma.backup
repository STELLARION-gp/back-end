generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuizParticipants {
  id                     Int     @id @default(autoincrement())
  quiz_id                Int
  user_id                Int
  correct_question_count Int     @default(0)
  score                  Int     @default(0)
  Quizzes                Quizzes @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  users                  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id                   Int      @id @default(autoincrement())
  quiz_id              Int
  question             String
  answers              String[]
  correct_answer       String
  question_explanation String?
  Quizzes              Quizzes  @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
}

model Quizzes {
  id                 Int                   @id @default(autoincrement())
  name               String
  category           String
  description        String
  time               DateTime?
  question_count     Int                   @default(0)
  participants_count Int                   @default(0)
  time_limit         Int
  user_id            Int
  created_at         DateTime              @default(now())
  modified_at        DateTime
  status             QuizStatus            @default(open)
  level              quiz_difficulty_level
  QuizParticipants   QuizParticipants[]
  QuizQuestion       QuizQuestion[]
  users              users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_quizzes_user_id")
}

model astronomy_events {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  description     String
  visibility      String            @db.VarChar(100)
  best_time       String            @db.VarChar(100)
  image_url       String?           @db.VarChar(500)
  event_date      DateTime          @db.Timestamp(6)
  end_date        DateTime?         @db.Timestamp(6)
  duration        String            @db.VarChar(100)
  event_type      String            @db.VarChar(100)
  is_active       Boolean           @default(true)
  created_by      Int
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  users           users             @relation(fields: [created_by], references: [id], onDelete: Cascade)
  event_reminders event_reminders[]

  @@index([is_active], map: "idx_astronomy_events_active")
  @@index([created_by], map: "idx_astronomy_events_created_by")
  @@index([event_date], map: "idx_astronomy_events_date")
  @@index([event_type], map: "idx_astronomy_events_type")
}

model blog_categories {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.VarChar(100)
  description             String?
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  blog_category_relations blog_category_relations[]
}

model blog_category_relations {
  id              Int              @id @default(autoincrement())
  blog_id         Int?
  category_id     Int?
  blogs           blogs?           @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blog_categories blog_categories? @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blog_id, category_id])
}

model blog_comments {
  id                  Int             @id @default(autoincrement())
  blog_id             Int?
  user_id             Int?
  parent_comment_id   Int?
  content             String
  is_edited           Boolean?        @default(false)
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  updated_at          DateTime?       @default(now()) @db.Timestamp(6)
  blogs               blogs?          @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blog_comments       blog_comments?  @relation("blog_commentsToblog_comments", fields: [parent_comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_blog_comments blog_comments[] @relation("blog_commentsToblog_comments")
  users               users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([blog_id], map: "idx_blog_comments_blog_id")
  @@index([user_id], map: "idx_blog_comments_user_id")
}

model blog_likes {
  id         Int       @id @default(autoincrement())
  blog_id    Int?
  user_id    Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  blogs      blogs?    @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blog_id, user_id])
  @@index([blog_id], map: "idx_blog_likes_blog_id")
  @@index([user_id], map: "idx_blog_likes_user_id")
}

model blog_views {
  id         Int       @id @default(autoincrement())
  blog_id    Int?
  user_id    Int?
  ip_address String?   @db.Inet
  user_agent String?
  viewed_at  DateTime? @default(now()) @db.Timestamp(6)
  blogs      blogs?    @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([blog_id], map: "idx_blog_views_blog_id")
}

model blogs {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  content                 String
  excerpt                 String?
  featured_image          String?
  author_id               Int?
  author_name             String?                   @db.VarChar(255)
  status                  String?                   @default("draft") @db.VarChar(20)
  is_featured             Boolean?                  @default(false)
  views_count             Int?                      @default(0)
  likes_count             Int?                      @default(0)
  comments_count          Int?                      @default(0)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  image_url               String?                   @db.VarChar(500)
  published_at            DateTime?                 @db.Timestamp(6)
  view_count              Int?                      @default(0)
  like_count              Int?                      @default(0)
  comment_count           Int?                      @default(0)
  tags                    Json?                     @default("[]")
  metadata                Json?                     @default("{}")
  blog_ratings            blog_ratings[]
  blog_category_relations blog_category_relations[]
  blog_comments           blog_comments[]
  blog_likes              blog_likes[]
  blog_views              blog_views[]
  users                   users?                    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([author_id], map: "idx_blogs_author_id")
  @@index([created_at], map: "idx_blogs_created_at")
  @@index([published_at], map: "idx_blogs_published_at")
  @@index([status], map: "idx_blogs_status")
}

model chat_messages {
  id                  Int                 @id @default(autoincrement())
  group_id            Int
  user_id             Int?
  message_text        String
  message_type        String              @default("text") @db.VarChar(20)
  reply_to            Int?
  is_edited           Boolean             @default(false)
  is_deleted          Boolean             @default(false)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @default(now()) @db.Timestamp(6)
  group_chats         group_chats         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  chat_messages       chat_messages?      @relation("chat_messagesTochat_messages", fields: [reply_to], references: [id])
  other_chat_messages chat_messages[]     @relation("chat_messagesTochat_messages")
  users               users?              @relation(fields: [user_id], references: [id])
  message_reactions   message_reactions[]

  @@index([group_id, created_at], map: "idx_chat_messages_group_created")
  @@index([reply_to], map: "idx_chat_messages_reply_to")
  @@index([user_id], map: "idx_chat_messages_user_id")
}

model users {
  id                                                                                           Int                                    @id @default(autoincrement())
  firebase_uid                                                                                 String                                 @unique @db.VarChar(255)
  email                                                                                        String                                 @unique @db.VarChar(255)
  role                                                                                         user_role?                             @default(learner)
  first_name                                                                                   String?                                @db.VarChar(100)
  last_name                                                                                    String?                                @db.VarChar(100)
  is_active                                                                                    Boolean?                               @default(true)
  last_login                                                                                   DateTime?                              @db.Timestamp(6)
  created_at                                                                                   DateTime?                              @default(now()) @db.Timestamp(6)
  updated_at                                                                                   DateTime?                              @default(now()) @db.Timestamp(6)
  display_name                                                                                 String?                                @db.VarChar(100)
  profile_data                                                                                 Json?                                  @default("{}")
  role_specific_data                                                                           Json?                                  @default("{}")
  subscription_plan                                                                            subscription_plan?                     @default(starseeker)
  subscription_status                                                                          subscription_status?                   @default(active)
  subscription_start_date                                                                      DateTime?                              @default(now()) @db.Timestamp(6)
  subscription_end_date                                                                        DateTime?                              @db.Timestamp(6)
  auto_renew                                                                                   Boolean?                               @default(false)
  chatbot_questions_used                                                                       Int?                                   @default(0)
  chatbot_questions_reset_date                                                                 DateTime?                              @default(dbgenerated("CURRENT_DATE")) @db.Date
  QuizParticipants                                                                             QuizParticipants[]
  Quizzes                                                                                      Quizzes[]
  created_astronomy_events                                                                     astronomy_events[]                     @relation("AstronomyEventCreator")
  blog_comments                                                                                blog_comments[]
  blog_likes                                                                                   blog_likes[]
  blog_ratings                                                                                 blog_ratings[]
  blog_views                                                                                   blog_views[]
  blogs                                                                                        blogs[]
  chat_messages                                                                                chat_messages[]                        @relation("ChatMessageUser")
  chatbot_sessions                                                                             chatbot_sessions[]
  chatbot_usage                                                                                chatbot_usage[]
  event_reminders                                                                              event_reminders[]                      @relation("UserEventReminders")
  created_groups                                                                               group_chats[]                          @relation("GroupChatCreator")
  group_memberships                                                                            group_members[]                        @relation("GroupMembership")
  guide_application                                                                            guide_application[]
  influencer_application                                                                       influencer_application[]
  media_uploads                                                                                media_uploads[]
  mentor_application                                                                           mentor_application[]
  message_reactions                                                                            message_reactions[]                    @relation("MessageReaction")
  night_camp_registrations                                                                     night_camp_registrations[]
  night_camp_volunteering_applications_night_camp_volunteering_applications_reviewed_byTousers night_camp_volunteering_applications[] @relation("night_camp_volunteering_applications_reviewed_byTousers")
  night_camp_volunteering_applications_night_camp_volunteering_applications_user_idTousers     night_camp_volunteering_applications[] @relation("night_camp_volunteering_applications_user_idTousers")
  payments                                                                                     payments[]
  poll_comments                                                                                poll_comments[]                        @relation("PollCommenter")
  poll_votes                                                                                   poll_votes[]                           @relation("PollVoter")
  created_polls                                                                                polls[]                                @relation("PollCreator")
  role_upgrade_requests_role_upgrade_requests_reviewer_idTousers                               role_upgrade_requests[]                @relation("role_upgrade_requests_reviewer_idTousers")
  role_upgrade_requests_role_upgrade_requests_user_idTousers                                   role_upgrade_requests[]                @relation("role_upgrade_requests_user_idTousers")
  service_bookings                                                                             service_bookings[]
  service_reviews                                                                              service_reviews[]
  services                                                                                     services[]
  session_enrollments                                                                          session_enrollments[]                  @relation("UserSessionEnrollments")
  created_sessions                                                                             sessions[]                             @relation("SessionCreator")
  discussion_comment_likes                                                                     space_discussion_comment_likes[]       @relation("DiscussionCommentLikes")
  discussion_comments                                                                          space_discussion_comments[]            @relation("DiscussionComments")
  discussion_likes                                                                             space_discussion_likes[]               @relation("DiscussionLikes")
  authored_discussions                                                                         space_discussions[]                    @relation("DiscussionAuthor")
  space_news_published                                                                         space_news[]                           @relation("SpaceNewsPublisher")
  space_news_comments                                                                          space_news_comments[]                  @relation("SpaceNewsComments")
  space_news_likes                                                                             space_news_likes[]                     @relation("SpaceNewsLikes")
  stargazing_spot_reviews                                                                      stargazing_spot_reviews[]              @relation("StargazingSpotReviews")
  created_stargazing_spots                                                                     stargazing_spots[]                     @relation("StargazingSpotCreator")
  subscriptions                                                                                subscriptions[]
  user_settings                                                                                user_settings?
  chatbot_feedback                                                                             chatbot_feedback[]

  @@index([is_active], map: "idx_users_active")
  @@index([email], map: "idx_users_email")
  @@index([firebase_uid], map: "idx_users_firebase_uid")
  @@index([role], map: "idx_users_role")
  @@index([subscription_plan], map: "idx_users_subscription_plan")
  @@index([subscription_status], map: "idx_users_subscription_status")
}

model chatbot_feedback {
  id         Int               @id @default(autoincrement())
  message_id String            @db.Uuid
  session_id String            @db.Uuid
  user_id    Int
  rating     Int               @db.SmallInt
  feedback   String?
  created_at DateTime          @default(now()) @db.Timestamp(6)
  message    chatbot_messages  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  session    chatbot_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user       users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([message_id], map: "idx_chatbot_feedback_message_id")
  @@index([session_id], map: "idx_chatbot_feedback_session_id")
  @@index([user_id], map: "idx_chatbot_feedback_user_id")
}

model blog_ratings {
  id         Int       @id @default(autoincrement())
  blog_id    Int?
  user_id    Int?
  rating     Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)
  blogs      blogs?    @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blog_id, user_id])
  @@index([blog_id], map: "idx_blog_ratings_blog_id")
  @@index([user_id], map: "idx_blog_ratings_user_id")
}

model chatbot_messages {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String?            @db.Uuid
  content          String
  is_bot           Boolean            @default(false)
  firebase_uid     String?            @db.VarChar(255)
  confidence       Decimal?           @db.Decimal(3, 2)
  intent           String?            @db.VarChar(100)
  entities         Json?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  chatbot_feedback chatbot_feedback[]
  chatbot_sessions chatbot_sessions?  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firebase_uid], map: "idx_chatbot_messages_firebase_uid")
  @@index([session_id], map: "idx_chatbot_messages_session_id")
  @@index([created_at], map: "idx_chatbot_messages_timestamp")
}

model chatbot_sessions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          Int?
  firebase_uid     String             @db.VarChar(255)
  title            String?            @default("New Chat") @db.VarChar(255)
  is_active        Boolean?           @default(true)
  message_count    Int?               @default(0)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  chatbot_feedback chatbot_feedback[]
  chatbot_messages chatbot_messages[]
  users            users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active], map: "idx_chatbot_sessions_active")
  @@index([firebase_uid], map: "idx_chatbot_sessions_firebase_uid")
}

model chatbot_usage {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  question_count Int?      @default(1)
  usage_date     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, usage_date])
  @@index([user_id, usage_date], map: "idx_chatbot_usage_user_date")
}

model event_reminders {
  id                Int              @id @default(autoincrement())
  user_id           Int
  event_id          Int
  reminder_time     DateTime         @db.Timestamp(6)
  is_sent           Boolean          @default(false)
  notification_type String           @default("email") @db.VarChar(50)
  created_at        DateTime         @default(now()) @db.Timestamp(6)
  updated_at        DateTime         @default(now()) @db.Timestamp(6)
  astronomy_events  astronomy_events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  users             users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id], map: "unique_user_event_reminder")
  @@index([is_sent], map: "idx_event_reminders_sent")
  @@index([reminder_time], map: "idx_event_reminders_time")
}

model events {
  id                      Int       @id @default(autoincrement())
  event_name              String    @db.VarChar(255)
  society_name            String    @db.VarChar(255)
  description             String
  visibility              String    @db.VarChar(50)
  date                    DateTime  @db.Date
  time                    String    @db.VarChar(100)
  location                String    @db.VarChar(255)
  event_category          String    @db.VarChar(100)
  needed_volunteers_count Int?
  organized_by            String    @db.VarChar(255)
  image_urls              String[]
  max_participants        Int?
  event_status            String    @db.VarChar(50)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  status                  String?   @default("pending") @db.VarChar(50)
  created_by              Int?
  moderated_by            Int?

  @@index([created_by], map: "idx_events_created_by")
  @@index([date], map: "idx_events_date")
  @@index([moderated_by], map: "idx_events_moderated_by")
  @@index([status], map: "idx_events_moderation_status")
  @@index([event_status], map: "idx_events_status")
  @@index([visibility], map: "idx_events_visibility")
}

model group_chats {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255)
  description   String?
  type          String          @default("public") @db.VarChar(20)
  created_by    Int
  avatar_url    String?         @db.VarChar(500)
  is_active     Boolean         @default(true)
  max_members   Int             @default(1000)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  chat_messages chat_messages[]
  users         users           @relation(fields: [created_by], references: [id], onDelete: Cascade)
  group_members group_members[]

  @@index([created_at], map: "idx_group_chats_created_at")
  @@index([created_by], map: "idx_group_chats_created_by")
  @@index([type, is_active], map: "idx_group_chats_type_active")
}

model group_members {
  id          Int         @id @default(autoincrement())
  group_id    Int
  user_id     Int
  role        String      @default("member") @db.VarChar(20)
  joined_at   DateTime    @default(now()) @db.Timestamp(6)
  is_muted    Boolean     @default(false)
  group_chats group_chats @relation(fields: [group_id], references: [id], onDelete: Cascade)
  users       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id], map: "idx_group_members_group_id")
  @@index([user_id], map: "idx_group_members_user_id")
}

model guide_application {
  application_id             Int                         @id @default(autoincrement())
  user_id                    Int
  first_name                 String                      @db.VarChar(100)
  last_name                  String                      @db.VarChar(100)
  email                      String                      @db.VarChar(255)
  phone                      String                      @db.VarChar(20)
  date_of_birth              DateTime?                   @db.Date
  address                    String?
  city                       String?                     @db.VarChar(100)
  current_occupation         String?                     @db.VarChar(255)
  education_level            String?                     @db.VarChar(255)
  astronomy_education        String?
  guide_experience           String?
  total_experience           Int                         @default(0)
  certifications             Json?                       @default("[]")
  astronomy_skills           Json?                       @default("[]")
  languages                  Json?                       @default("[]")
  first_aid                  Boolean?                    @default(false)
  driving_license            Boolean?                    @default(false)
  camp_types                 Json?                       @default("[]")
  group_sizes                Json?                       @default("[]")
  equipment_familiarity      Json?                       @default("[]")
  outdoor_experience         String?
  available_dates            Json?                       @default("[]")
  preferred_locations        Json?                       @default("[]")
  accommodation_needs        String?
  transportation_needs       String?
  motivation                 String?
  special_skills             String?
  emergency_contact          Json                        @default("{}")
  documents                  Json?                       @default("{}")
  selected_camps             Json?                       @default("[]")
  application_status         application_status?         @default(pending)
  approve_application_status approve_application_status? @default(pending)
  terms_accepted             Boolean?                    @default(false)
  background_check_consent   Boolean?                    @default(false)
  deletion_status            Boolean?                    @default(false)
  submitted_at               DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                   @default(now()) @db.Timestamp(6)
  users                      users                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([approve_application_status], map: "idx_guide_app_approve_status")
  @@index([application_status], map: "idx_guide_app_status")
  @@index([submitted_at], map: "idx_guide_app_submitted_at")
  @@index([user_id], map: "idx_guide_app_user_id")
}

model influencer_application {
  application_id             Int                         @id @default(autoincrement())
  user_id                    Int?
  first_name                 String?                     @db.VarChar(100)
  last_name                  String?                     @db.VarChar(100)
  email                      String?                     @db.VarChar(255)
  phone_number               String?                     @db.VarChar(50)
  country                    String?                     @db.VarChar(100)
  bio                        String?
  specialization_tags        Json?
  social_links               Json?
  intro_video_url            String?                     @db.VarChar(255)
  sample_content_links       Json?
  preferred_session_format   session_format?
  willing_to_host_sessions   Boolean?
  tools_used                 Json?
  application_status         application_status?         @default(pending)
  approve_application_status approve_application_status? @default(pending)
  deletion_status            Boolean?                    @default(false)
  submitted_at               DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                   @default(now()) @db.Timestamp(6)
  users                      users?                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deletion_status], map: "idx_influencer_application_deletion_status")
  @@index([application_status], map: "idx_influencer_application_status")
  @@index([user_id], map: "idx_influencer_application_user_id")
}

model media_uploads {
  id         Int       @id @default(autoincrement())
  user_id    Int
  file_name  String    @db.VarChar(255)
  file_path  String    @db.VarChar(500)
  file_type  String    @db.VarChar(100)
  file_size  Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_media_uploads_user_id")
}

model mentor_application {
  application_id             Int                         @id @default(autoincrement())
  user_id                    Int?
  first_name                 String?                     @db.VarChar(100)
  last_name                  String?                     @db.VarChar(100)
  email                      String?                     @db.VarChar(255)
  phone_number               String?                     @db.VarChar(50)
  date_of_birth              DateTime?                   @db.Date
  country                    String?                     @db.VarChar(100)
  profile_bio                String?
  educational_background     String?
  area_of_expertise          Json?
  linkedin_profile           String?                     @db.VarChar(255)
  intro_video_url            String?                     @db.VarChar(255)
  max_mentees                Int?
  availability_schedule      Json?
  motivation_statement       String?
  portfolio_attachments      Json?
  application_status         application_status?         @default(pending)
  approve_application_status approve_application_status? @default(pending)
  deletion_status            Boolean?                    @default(false)
  submitted_at               DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                   @default(now()) @db.Timestamp(6)
  users                      users?                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deletion_status], map: "idx_mentor_application_deletion_status")
  @@index([application_status], map: "idx_mentor_application_status")
  @@index([user_id], map: "idx_mentor_application_user_id")
}

model message_reactions {
  id            Int           @id @default(autoincrement())
  message_id    Int
  user_id       Int
  reaction      String        @db.VarChar(50)
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  chat_messages chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id, reaction])
  @@index([message_id], map: "idx_message_reactions_message_id")
  @@index([user_id], map: "idx_message_reactions_user_id")
}

model night_camp_registrations {
  id              Int          @id @default(autoincrement())
  camp_id         Int?
  user_id         Int?
  status          String?      @default("confirmed") @db.VarChar(50)
  registered_date DateTime?    @default(dbgenerated("CURRENT_DATE")) @db.Date
  registered_time DateTime?    @default(dbgenerated("CURRENT_TIME")) @db.Time(6)
  created_at      DateTime?    @default(now()) @db.Timestamp(6)
  updated_at      DateTime?    @default(now()) @db.Timestamp(6)
  night_camps     night_camps? @relation(fields: [camp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([camp_id, user_id])
  @@index([camp_id], map: "idx_night_camp_registrations_camp_id")
  @@index([registered_date], map: "idx_night_camp_registrations_date")
  @@index([status], map: "idx_night_camp_registrations_status")
  @@index([user_id], map: "idx_night_camp_registrations_user_id")
}

model night_camp_volunteering {
  id                   Int          @id @default(autoincrement())
  night_camp_id        Int?
  volunteering_role    String       @db.VarChar(255)
  number_of_applicants Int?         @default(0)
  created_at           DateTime?    @default(now()) @db.Timestamp(6)
  night_camps          night_camps? @relation(fields: [night_camp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([night_camp_id], map: "idx_night_camp_volunteering_camp_id")
}

model night_camp_volunteering_applications {
  id                                                            Int          @id @default(autoincrement())
  night_camp_id                                                 Int?
  user_id                                                       Int?
  volunteering_role                                             String       @db.VarChar(255)
  motivation                                                    String?
  experience                                                    String?
  availability                                                  String?
  emergency_contact_name                                        String?      @db.VarChar(255)
  emergency_contact_phone                                       String?      @db.VarChar(50)
  emergency_contact_relationship                                String?      @db.VarChar(100)
  status                                                        String?      @default("pending") @db.VarChar(50)
  application_date                                              DateTime?    @default(now()) @db.Timestamp(6)
  reviewed_by                                                   Int?
  reviewed_at                                                   DateTime?    @db.Timestamp(6)
  review_notes                                                  String?
  created_at                                                    DateTime?    @default(now()) @db.Timestamp(6)
  updated_at                                                    DateTime?    @default(now()) @db.Timestamp(6)
  night_camps                                                   night_camps? @relation(fields: [night_camp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_night_camp_volunteering_applications_reviewed_byTousers users?       @relation("night_camp_volunteering_applications_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_night_camp_volunteering_applications_user_idTousers     users?       @relation("night_camp_volunteering_applications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([night_camp_id, user_id, volunteering_role], map: "night_camp_volunteering_appli_night_camp_id_user_id_volunte_key")
  @@index([night_camp_id], map: "idx_night_camp_volunteering_applications_camp_id")
  @@index([status], map: "idx_night_camp_volunteering_applications_status")
  @@index([user_id], map: "idx_night_camp_volunteering_applications_user_id")
}

model night_camps {
  id                                   Int                                    @id @default(autoincrement())
  name                                 String                                 @db.VarChar(255)
  organized_by                         String?                                @db.VarChar(255)
  sponsored_by                         String?                                @db.VarChar(255)
  description                          String?
  date                                 DateTime                               @db.Date
  time                                 DateTime?                              @db.Time(6)
  location                             String                                 @db.VarChar(500)
  number_of_participants               Int?                                   @default(0)
  image_urls                           Json?                                  @default("[]")
  emergency_contact                    String?                                @db.VarChar(255)
  status                               String?                                @default("pending") @db.VarChar(50)
  created_at                           DateTime?                              @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                              @default(now()) @db.Timestamp(6)
  night_camp_registrations             night_camp_registrations[]
  night_camp_volunteering              night_camp_volunteering[]
  night_camp_volunteering_applications night_camp_volunteering_applications[]
  night_camps_activities               night_camps_activities[]
  night_camps_equipment                night_camps_equipment[]

  @@index([created_at], map: "idx_night_camps_created_at")
  @@index([date], map: "idx_night_camps_date")
  @@index([location], map: "idx_night_camps_location")
}

model night_camps_activities {
  id            Int          @id @default(autoincrement())
  night_camp_id Int?
  activity      String       @db.VarChar(255)
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  night_camps   night_camps? @relation(fields: [night_camp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([night_camp_id], map: "idx_night_camps_activities_camp_id")
}

model night_camps_equipment {
  id             Int                @id @default(autoincrement())
  night_camp_id  Int?
  category       equipment_category
  equipment_name String             @db.VarChar(255)
  created_at     DateTime?          @default(now()) @db.Timestamp(6)
  night_camps    night_camps?       @relation(fields: [night_camp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([night_camp_id], map: "idx_night_camps_equipment_camp_id")
  @@index([category], map: "idx_night_camps_equipment_category")
}

model payments {
  id                     Int             @id @default(autoincrement())
  user_id                Int?
  subscription_id        Int?
  amount                 Decimal         @db.Decimal(10, 2)
  currency               String?         @default("LKR") @db.VarChar(3)
  payment_status         payment_status? @default(pending)
  payment_method         String?         @db.VarChar(50)
  payment_gateway        String?         @default("payhere") @db.VarChar(50)
  gateway_transaction_id String?         @db.VarChar(255)
  gateway_order_id       String?         @db.VarChar(255)
  payment_date           DateTime?       @db.Timestamp(6)
  metadata               Json?           @default("{}")
  created_at             DateTime?       @default(now()) @db.Timestamp(6)
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  subscriptions          subscriptions?  @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_status], map: "idx_payments_status")
  @@index([subscription_id], map: "idx_payments_subscription_id")
  @@index([user_id], map: "idx_payments_user_id")
}

model poll_choices {
  id         Int          @id @default(autoincrement())
  poll_id    Int
  choice     String       @db.VarChar(255)
  vote_count Int          @default(0)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  polls      polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  poll_votes poll_votes[]

  @@unique([poll_id, choice], map: "unique_poll_choice")
  @@index([poll_id], map: "idx_poll_choices_poll_id")
}

model poll_comments {
  id         Int      @id @default(autoincrement())
  poll_id    Int
  user_id    Int
  comment    String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  polls      polls    @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_poll_comments_created_at")
  @@index([poll_id], map: "idx_poll_comments_poll_id")
  @@index([user_id], map: "idx_poll_comments_user_id")
}

model poll_votes {
  id           Int          @id @default(autoincrement())
  poll_id      Int
  choice_id    Int
  user_id      Int
  voted_at     DateTime     @default(now()) @db.Timestamp(6)
  poll_choices poll_choices @relation(fields: [choice_id], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, user_id], map: "unique_user_vote_per_poll")
  @@index([choice_id], map: "idx_poll_votes_choice_id")
  @@index([poll_id], map: "idx_poll_votes_poll_id")
  @@index([user_id], map: "idx_poll_votes_user_id")
}

model polls {
  id            Int             @id @default(autoincrement())
  title         String          @db.VarChar(255)
  description   String?
  created_by    Int
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  is_active     Boolean         @default(true)
  poll_choices  poll_choices[]
  poll_comments poll_comments[]
  users         users           @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_polls_created_at")
  @@index([created_by], map: "idx_polls_created_by")
  @@index([is_active], map: "idx_polls_is_active")
}

model role_upgrade_requests {
  id                                             Int       @id @default(autoincrement())
  user_id                                        Int?
  current_user_role                              String    @db.VarChar(20)
  requested_user_role                            String    @db.VarChar(20)
  reason                                         String?
  supporting_evidence                            Json?     @default("[]")
  status                                         String?   @default("pending") @db.VarChar(20)
  reviewer_id                                    Int?
  reviewer_notes                                 String?
  submitted_at                                   DateTime? @default(now()) @db.Timestamp(6)
  reviewed_at                                    DateTime? @db.Timestamp(6)
  users_role_upgrade_requests_reviewer_idTousers users?    @relation("role_upgrade_requests_reviewer_idTousers", fields: [reviewer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_role_upgrade_requests_user_idTousers     users?    @relation("role_upgrade_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_role_upgrade_requests_status")
  @@index([user_id], map: "idx_role_upgrade_requests_user_id")
}

model service_availability {
  id              Int                 @id @default(autoincrement())
  service_id      Int
  available_date  DateTime            @db.Date
  start_time      DateTime?           @db.Time(6)
  end_time        DateTime?           @db.Time(6)
  slots_available Int
  slots_booked    Int                 @default(0)
  status          availability_status @default(available)
  notes           String?
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  updated_at      DateTime            @default(now()) @db.Timestamp(6)
  services        services            @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, available_date, start_time], map: "unique_service_availability_slot")
  @@index([available_date], map: "idx_service_availability_date")
  @@index([service_id], map: "idx_service_availability_service_id")
  @@index([status], map: "idx_service_availability_status")
}

model service_bookings {
  id                  Int                    @id @default(autoincrement())
  service_id          Int
  user_id             Int
  booking_date        DateTime               @db.Date
  booking_time        DateTime?              @db.Time(6)
  participants_count  Int                    @default(1)
  total_amount        Decimal                @db.Decimal(10, 2)
  payment_status      booking_payment_status @default(pending)
  payment_method      String?                @db.VarChar(50)
  transaction_id      String?                @db.VarChar(255)
  booking_status      booking_status         @default(pending)
  special_requests    String?
  cancellation_reason String?
  cancelled_at        DateTime?              @db.Timestamp(6)
  confirmed_at        DateTime?              @db.Timestamp(6)
  completed_at        DateTime?              @db.Timestamp(6)
  created_at          DateTime               @default(now()) @db.Timestamp(6)
  updated_at          DateTime               @default(now()) @db.Timestamp(6)
  services            services               @relation(fields: [service_id], references: [id], onDelete: Cascade)
  users               users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([service_id, user_id, booking_date], map: "unique_service_user_booking")
  @@index([booking_date], map: "idx_service_bookings_date")
  @@index([payment_status], map: "idx_service_bookings_payment_status")
  @@index([service_id], map: "idx_service_bookings_service_id")
  @@index([booking_status], map: "idx_service_bookings_status")
  @@index([user_id], map: "idx_service_bookings_user_id")
}

model service_media {
  id            Int      @id @default(autoincrement())
  service_id    Int
  media_url     String   @db.VarChar(500)
  media_type    String   @db.VarChar(50)
  display_order Int      @default(0)
  caption       String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  services      services @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([display_order], map: "idx_service_media_order")
  @@index([service_id], map: "idx_service_media_service_id")
}

model service_reviews {
  id          Int      @id @default(autoincrement())
  service_id  Int
  user_id     Int
  rating      Int      @db.SmallInt
  review      String
  images      Json?    @default("[]")
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  services    services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([service_id, user_id], map: "unique_service_user_review")
  @@index([rating], map: "idx_service_reviews_rating")
  @@index([service_id], map: "idx_service_reviews_service_id")
  @@index([user_id], map: "idx_service_reviews_user_id")
}

model services {
  id                   Int                    @id @default(autoincrement())
  title                String                 @db.VarChar(255)
  description          String
  category             service_category
  price                Decimal                @db.Decimal(10, 2)
  duration             String                 @db.VarChar(100)
  max_participants     Int
  location             String                 @db.VarChar(500)
  difficulty           service_difficulty
  equipment            Json                   @default("[]")
  next_available       DateTime               @db.Date
  image_url            String?                @db.VarChar(500)
  featured             Boolean                @default(false)
  tags                 Json                   @default("[]")
  requirements         String?
  cancellation_policy  String?
  meeting_point        String?                @db.VarChar(500)
  what_to_expect       String?
  weather_policy       weather_policy_type?
  booking_deadline     Int                    @default(24)
  languages            Json                   @default("[]")
  certification        String?                @db.VarChar(500)
  experience           String?
  group_discount       Boolean                @default(false)
  private_booking      Boolean                @default(false)
  instant_booking      Boolean                @default(true)
  status               service_status         @default(active)
  views_count          Int                    @default(0)
  bookings_count       Int                    @default(0)
  rating               Float                  @default(0)
  review_count         Int                    @default(0)
  created_by           Int
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  service_availability service_availability[]
  service_bookings     service_bookings[]
  service_media        service_media[]
  service_reviews      service_reviews[]
  users                users                  @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([is_active], map: "idx_services_active")
  @@index([category], map: "idx_services_category")
  @@index([created_by], map: "idx_services_created_by")
  @@index([difficulty], map: "idx_services_difficulty")
  @@index([featured], map: "idx_services_featured")
  @@index([next_available], map: "idx_services_next_available")
  @@index([rating], map: "idx_services_rating")
  @@index([status], map: "idx_services_status")
}

model session_enrollments {
  id               Int                       @id @default(autoincrement())
  user_id          Int
  session_id       Int
  enrollment_date  DateTime                  @default(now()) @db.Timestamp(6)
  payment_status   enrollment_payment_status @default(pending)
  payment_amount   Decimal?                  @db.Decimal(10, 2)
  payment_method   String?                   @db.VarChar(50)
  transaction_id   String?                   @db.VarChar(255)
  access_granted   Boolean                   @default(false)
  completed        Boolean                   @default(false)
  progress         Int?                      @default(0)
  last_accessed_at DateTime?                 @db.Timestamp(6)
  notes            String?
  created_at       DateTime                  @default(now()) @db.Timestamp(6)
  updated_at       DateTime                  @default(now()) @db.Timestamp(6)
  sessions         sessions                  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  users            users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, session_id], map: "unique_user_session_enrollment")
  @@index([access_granted], map: "idx_session_enrollments_access")
  @@index([enrollment_date], map: "idx_session_enrollments_date")
  @@index([payment_status], map: "idx_session_enrollments_payment_status")
  @@index([session_id], map: "idx_session_enrollments_session_id")
  @@index([user_id], map: "idx_session_enrollments_user_id")
}

model sessions {
  id                  Int                   @id @default(autoincrement())
  title               String                @db.VarChar(255)
  session_type        session_type
  payment_type        payment_type
  price               Decimal?              @db.Decimal(10, 2)
  duration            Int
  session_date        DateTime              @db.Date
  session_time        DateTime              @db.Time(6)
  max_participants    Int?
  difficulty_level    difficulty_level
  session_link        String?               @db.VarChar(500)
  description         String
  materials           Json?                 @default("[]")
  session_notes       String?
  created_by          Int
  created_date        DateTime              @default(now()) @db.Date
  created_time        DateTime              @default(now()) @db.Time(6)
  is_enabled          Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  session_enrollments session_enrollments[]
  users               users                 @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([created_by], map: "idx_sessions_created_by")
  @@index([session_date], map: "idx_sessions_date")
  @@index([difficulty_level], map: "idx_sessions_difficulty")
  @@index([is_enabled], map: "idx_sessions_enabled")
  @@index([payment_type], map: "idx_sessions_payment_type")
  @@index([session_type], map: "idx_sessions_type")
}

model space_discussion_comment_likes {
  id                        Int                       @id @default(autoincrement())
  comment_id                Int
  user_id                   Int
  created_at                DateTime                  @default(now()) @db.Timestamp(6)
  space_discussion_comments space_discussion_comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  users                     users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@index([comment_id], map: "idx_space_discussion_comment_likes_comment_id")
  @@index([user_id], map: "idx_space_discussion_comment_likes_user_id")
}

model space_discussion_comments {
  id                              Int                              @id @default(autoincrement())
  discussion_id                   Int
  user_id                         Int
  parent_id                       Int?
  content                         String
  is_edited                       Boolean                          @default(false)
  created_at                      DateTime                         @default(now()) @db.Timestamp(6)
  updated_at                      DateTime                         @default(now()) @db.Timestamp(6)
  space_discussion_comment_likes  space_discussion_comment_likes[]
  space_discussions               space_discussions                @relation(fields: [discussion_id], references: [id], onDelete: Cascade)
  space_discussion_comments       space_discussion_comments?       @relation("space_discussion_commentsTospace_discussion_comments", fields: [parent_id], references: [id], onDelete: Cascade)
  other_space_discussion_comments space_discussion_comments[]      @relation("space_discussion_commentsTospace_discussion_comments")
  users                           users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_space_discussion_comments_created_at")
  @@index([discussion_id], map: "idx_space_discussion_comments_discussion_id")
  @@index([parent_id], map: "idx_space_discussion_comments_parent_id")
  @@index([user_id], map: "idx_space_discussion_comments_user_id")
}

model space_discussion_likes {
  id                Int               @id @default(autoincrement())
  discussion_id     Int
  user_id           Int
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  space_discussions space_discussions @relation(fields: [discussion_id], references: [id], onDelete: Cascade)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([discussion_id, user_id])
  @@index([discussion_id], map: "idx_space_discussion_likes_discussion_id")
  @@index([user_id], map: "idx_space_discussion_likes_user_id")
}

model space_discussions {
  id                        Int                         @id @default(autoincrement())
  title                     String                      @db.VarChar(255)
  content                   String
  author_id                 Int
  category                  String                      @db.VarChar(100)
  is_sticky                 Boolean                     @default(false)
  is_closed                 Boolean                     @default(false)
  views_count               Int                         @default(0)
  replies_count             Int                         @default(0)
  last_activity             DateTime                    @default(now()) @db.Timestamp(6)
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @default(now()) @db.Timestamp(6)
  space_discussion_comments space_discussion_comments[]
  space_discussion_likes    space_discussion_likes[]
  users                     users                       @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([author_id], map: "idx_space_discussions_author_id")
  @@index([category], map: "idx_space_discussions_category")
  @@index([created_at], map: "idx_space_discussions_created_at")
  @@index([last_activity], map: "idx_space_discussions_last_activity")
  @@index([is_sticky], map: "idx_space_discussions_sticky")
}

model space_news {
  id                  Int                   @id @default(autoincrement())
  image_urls          Json?                 @default("[]")
  publish_date        DateTime              @db.Timestamp(6)
  title               String                @db.VarChar(255)
  number_of_likes     Int                   @default(0)
  number_of_comments  Int                   @default(0)
  content             String
  published_by        Int
  category            String                @db.VarChar(100)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  last_read_time      DateTime?             @db.Timestamp(6)
  users               users                 @relation(fields: [published_by], references: [id], onDelete: Cascade)
  space_news_comments space_news_comments[]
  space_news_likes    space_news_likes[]

  @@index([category], map: "idx_space_news_category")
  @@index([created_at], map: "idx_space_news_created_at")
  @@index([publish_date], map: "idx_space_news_publish_date")
  @@index([published_by], map: "idx_space_news_published_by")
}

model space_news_comments {
  id                        Int                   @id @default(autoincrement())
  space_news_id             Int
  user_id                   Int
  parent_comment_id         Int?
  content                   String
  is_edited                 Boolean               @default(false)
  created_at                DateTime              @default(now()) @db.Timestamp(6)
  updated_at                DateTime              @default(now()) @db.Timestamp(6)
  space_news_comments       space_news_comments?  @relation("space_news_commentsTospace_news_comments", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  other_space_news_comments space_news_comments[] @relation("space_news_commentsTospace_news_comments")
  space_news                space_news            @relation(fields: [space_news_id], references: [id], onDelete: Cascade)
  users                     users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([space_news_id], map: "idx_space_news_comments_news_id")
  @@index([parent_comment_id], map: "idx_space_news_comments_parent_id")
  @@index([user_id], map: "idx_space_news_comments_user_id")
}

model space_news_likes {
  id            Int        @id @default(autoincrement())
  space_news_id Int
  user_id       Int
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  space_news    space_news @relation(fields: [space_news_id], references: [id], onDelete: Cascade)
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([space_news_id, user_id])
  @@index([space_news_id], map: "idx_space_news_likes_news_id")
  @@index([user_id], map: "idx_space_news_likes_user_id")
}

model stargazing_spot_reviews {
