  @@unique([stargazing_spot_id, user_id], map: "unique_user_review_per_spot")
  @@index([rating], map: "idx_stargazing_reviews_rating")
  @@index([stargazing_spot_id], map: "idx_stargazing_reviews_spot_id")
  @@index([user_id], map: "idx_stargazing_reviews_user_id")
}

model stargazing_spots {
  id                      Int                       @id @default(autoincrement())
