model sessions {
  id               Int                   @id @default(autoincrement())
  title            String                @db.VarChar(255)
  session_type     session_type
  payment_type     payment_type
  price            Decimal?              @db.Decimal(10, 2)
  duration         Int
  session_date     DateTime              @db.Date
  session_time     DateTime              @db.Time(6)
  max_participants Int?
  difficulty_level difficulty_level
  session_link     String?               @db.VarChar(500)
  description      String
  materials        Json?                 @default("[]")
  session_notes    String?
  created_by       Int
  created_date     DateTime              @default(now()) @db.Date
  created_time     DateTime              @default(now()) @db.Time(6)
  is_enabled       Boolean               @default(true)
  created_at       DateTime              @default(now()) @db.Timestamp(6)
  updated_at       DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  enrollments      session_enrollments[]
  creator          users                 @relation("SessionCreator", fields: [created_by], references: [id], onDelete: Cascade)

  @@index([session_type], map: "idx_sessions_type")
  @@index([payment_type], map: "idx_sessions_payment_type")
  @@index([session_date], map: "idx_sessions_date")
  @@index([difficulty_level], map: "idx_sessions_difficulty")
  @@index([created_by], map: "idx_sessions_created_by")
  @@index([is_enabled], map: "idx_sessions_enabled")
}

model session_enrollments {
  id               Int                       @id @default(autoincrement())
  user_id          Int
  session_id       Int
  enrollment_date  DateTime                  @default(now()) @db.Timestamp(6)
  payment_status   enrollment_payment_status @default(pending)
  payment_amount   Decimal?                  @db.Decimal(10, 2)
  payment_method   String?                   @db.VarChar(50)
  transaction_id   String?                   @db.VarChar(255)
  access_granted   Boolean                   @default(false)
  completed        Boolean                   @default(false)
  progress         Int?                      @default(0)
  last_accessed_at DateTime?                 @db.Timestamp(6)
  notes            String?
  created_at       DateTime                  @default(now()) @db.Timestamp(6)
  updated_at       DateTime                  @default(now()) @updatedAt @db.Timestamp(6)
  session          sessions                  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user             users                     @relation("UserSessionEnrollments", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, session_id], map: "unique_user_session_enrollment")
  @@index([user_id], map: "idx_session_enrollments_user_id")
  @@index([session_id], map: "idx_session_enrollments_session_id")
  @@index([payment_status], map: "idx_session_enrollments_payment_status")
  @@index([enrollment_date], map: "idx_session_enrollments_date")
  @@index([access_granted], map: "idx_session_enrollments_access")
}

model polls {
  id          Int             @id @default(autoincrement())
  title       String          @db.VarChar(255)
  description String?
  created_by  Int
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  updated_at  DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  is_active   Boolean         @default(true)
  choices     poll_choices[]
  comments    poll_comments[]
  creator     users           @relation("PollCreator", fields: [created_by], references: [id], onDelete: Cascade)

  @@index([created_by], map: "idx_polls_created_by")
  @@index([created_at], map: "idx_polls_created_at")
  @@index([is_active], map: "idx_polls_is_active")
}

model poll_choices {
  id         Int          @id @default(autoincrement())
  poll_id    Int
  choice     String       @db.VarChar(255)
  vote_count Int          @default(0)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  poll       polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  votes      poll_votes[]

  @@unique([poll_id, choice], map: "unique_poll_choice")
  @@index([poll_id], map: "idx_poll_choices_poll_id")
}

model poll_votes {
  id        Int          @id @default(autoincrement())
  poll_id   Int
  choice_id Int
  user_id   Int
  voted_at  DateTime     @default(now()) @db.Timestamp(6)
  choice    poll_choices @relation(fields: [choice_id], references: [id], onDelete: Cascade)
  voter     users        @relation("PollVoter", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, user_id], map: "unique_user_vote_per_poll")
  @@index([poll_id], map: "idx_poll_votes_poll_id")
  @@index([user_id], map: "idx_poll_votes_user_id")
  @@index([choice_id], map: "idx_poll_votes_choice_id")
}

model poll_comments {
  id         Int      @id @default(autoincrement())
  poll_id    Int
  user_id    Int
  comment    String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  poll       polls    @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  commenter  users    @relation("PollCommenter", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([poll_id], map: "idx_poll_comments_poll_id")
  @@index([user_id], map: "idx_poll_comments_user_id")
  @@index([created_at], map: "idx_poll_comments_created_at")
}

model service_availability {
  id              Int                 @id @default(autoincrement())
  service_id      Int
  available_date  DateTime            @db.Date
  start_time      DateTime?           @db.Time(6)
  end_time        DateTime?           @db.Time(6)
  slots_available Int
  slots_booked    Int                 @default(0)
  status          availability_status @default(available)
  notes           String?
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  updated_at      DateTime            @default(now()) @db.Timestamp(6)
  services        services            @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, available_date, start_time], map: "unique_service_availability_slot")
  @@index([available_date], map: "idx_service_availability_date")
  @@index([service_id], map: "idx_service_availability_service_id")
  @@index([status], map: "idx_service_availability_status")
}

model service_bookings {
  id                  Int                    @id @default(autoincrement())
  service_id          Int
  user_id             Int
  booking_date        DateTime               @db.Date
  booking_time        DateTime?              @db.Time(6)
  participants_count  Int                    @default(1)
  total_amount        Decimal                @db.Decimal(10, 2)
  payment_status      booking_payment_status @default(pending)
  payment_method      String?                @db.VarChar(50)
  transaction_id      String?                @db.VarChar(255)
  booking_status      booking_status         @default(pending)
  special_requests    String?
  cancellation_reason String?
  cancelled_at        DateTime?              @db.Timestamp(6)
  confirmed_at        DateTime?              @db.Timestamp(6)
  completed_at        DateTime?              @db.Timestamp(6)
  created_at          DateTime               @default(now()) @db.Timestamp(6)
  updated_at          DateTime               @default(now()) @db.Timestamp(6)
  services            services               @relation(fields: [service_id], references: [id], onDelete: Cascade)
  users               users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([service_id, user_id, booking_date], map: "unique_service_user_booking")
  @@index([booking_date], map: "idx_service_bookings_date")
  @@index([payment_status], map: "idx_service_bookings_payment_status")
  @@index([service_id], map: "idx_service_bookings_service_id")
  @@index([booking_status], map: "idx_service_bookings_status")
  @@index([user_id], map: "idx_service_bookings_user_id")
}

model service_media {
  id            Int      @id @default(autoincrement())
  service_id    Int
  media_url     String   @db.VarChar(500)
  media_type    String   @db.VarChar(50)
  display_order Int      @default(0)
  caption       String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  services      services @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([display_order], map: "idx_service_media_order")
  @@index([service_id], map: "idx_service_media_service_id")
}

model service_reviews {
  id          Int      @id @default(autoincrement())
  service_id  Int
  user_id     Int
  rating      Int      @db.SmallInt
  review      String
  images      Json?    @default("[]")
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  services    services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([service_id, user_id], map: "unique_service_user_review")
  @@index([rating], map: "idx_service_reviews_rating")
  @@index([service_id], map: "idx_service_reviews_service_id")
  @@index([user_id], map: "idx_service_reviews_user_id")
}

model services {
  id                   Int                    @id @default(autoincrement())
  title                String                 @db.VarChar(255)
  description          String
  category             service_category
  price                Decimal                @db.Decimal(10, 2)
  duration             String                 @db.VarChar(100)
  max_participants     Int
  location             String                 @db.VarChar(500)
  difficulty           service_difficulty
  equipment            Json                   @default("[]")
  next_available       DateTime               @db.Date
  image_url            String?                @db.VarChar(500)
  featured             Boolean                @default(false)
  tags                 Json                   @default("[]")
  requirements         String?
  cancellation_policy  String?
  meeting_point        String?                @db.VarChar(500)
  what_to_expect       String?
  weather_policy       weather_policy_type?
  booking_deadline     Int                    @default(24)
  languages            Json                   @default("[]")
  certification        String?                @db.VarChar(500)
  experience           String?
  group_discount       Boolean                @default(false)
  private_booking      Boolean                @default(false)
  instant_booking      Boolean                @default(true)
  status               service_status         @default(active)
  views_count          Int                    @default(0)
  bookings_count       Int                    @default(0)
  rating               Float                  @default(0)
  review_count         Int                    @default(0)
  created_by           Int
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  service_availability service_availability[]
  service_bookings     service_bookings[]
  service_media        service_media[]
  service_reviews      service_reviews[]
  users                users                  @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([is_active], map: "idx_services_active")
  @@index([category], map: "idx_services_category")
  @@index([created_by], map: "idx_services_created_by")
  @@index([difficulty], map: "idx_services_difficulty")
  @@index([featured], map: "idx_services_featured")
  @@index([next_available], map: "idx_services_next_available")
  @@index([rating], map: "idx_services_rating")
  @@index([status], map: "idx_services_status")
}

