model stargazing_spot_reviews {
  id                 Int              @id @default(autoincrement())
  stargazing_spot_id Int
  user_id            Int
  rating             Int              @db.SmallInt
  review_text        String
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  stargazing_spot    stargazing_spots @relation(fields: [stargazing_spot_id], references: [id], onDelete: Cascade)
  user               users            @relation("StargazingSpotReviews", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([stargazing_spot_id, user_id], map: "unique_user_review_per_spot")
  @@index([stargazing_spot_id], map: "idx_stargazing_reviews_spot_id")
  @@index([user_id], map: "idx_stargazing_reviews_user_id")
  @@index([rating], map: "idx_stargazing_reviews_rating")
