  @@index([is_active], map: "idx_stargazing_spots_active")
  @@index([created_by], map: "idx_stargazing_spots_created_by")
  @@index([location], map: "idx_stargazing_spots_location")
  @@index([rating], map: "idx_stargazing_spots_rating")
